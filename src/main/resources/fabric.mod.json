{
  "schemaVersion": 1,
  "id": "fieldemitters",
  "version": "${version}",
  "name": "Field Emitters",
  "description": "Terrain-following forcefields with filters, detection and a Field Tuner.",
  "authors": [
    "ZeroTheAbsolute"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/field-emitters",
    "sources": "https://github.com/shikyo13/Field-Emitters/tree/mc/1.20.1-fabric",
    "issues": "https://github.com/shikyo13/Field-Emitters/issues"
  },
  "license": "LicenseRef-Field-Emitters-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.zerotheabsolute.fieldemitters.FieldEmitters"
    ],
    "client": [
      "com.zerotheabsolute.fieldemitters.client.FieldClient"
    ],
    "emi": [
      "com.zerotheabsolute.fieldemitters.client.emi.FieldEmiPlugin"
    ],
    "jei_mod_plugin": [
      "com.zerotheabsolute.fieldemitters.client.jei.FieldJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.0",
    "team_reborn_energy": ">=3.0.0 <4",
    "forgeconfigapiport": ">=8.0.0 <9",
    "zeromodscore": ">=0.1.1 <0.2.0"
  },
  "custom": {
    "modrinth": {
      "environments": {
        "client": "required",
        "server": "required"
      }
    }
  },
  "mixins": [
    "fieldemitters.mixins.json"
  ]
}
